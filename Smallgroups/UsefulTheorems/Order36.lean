theorem order36_C9_C4_invAction_moves_gen :
    order36_C9_C4_invAction (Multiplicative.ofAdd (1 : ZMod 4))
      (Multiplicative.ofAdd (1 : ZMod 9)) ≠ Multiplicative.ofAdd (1 : ZMod 9) := by
  intro h
