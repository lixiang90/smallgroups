theorem order36_c9_v4_fstAction_moves_gen :
    (order36_c9Action order36_chiV4_fst) order36_V4_g1
      (Multiplicative.ofAdd (1 : ZMod 9)) ≠ Multiplicative.ofAdd (1 : ZMod 9) := by
  intro h
