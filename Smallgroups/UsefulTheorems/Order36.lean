    rcases h with ⟨ha, hb0, hc0, hd⟩
    apply order36_E9_mulAut_ext
    · have he1 : β order36_E9_e1 = (Multiplicative.ofAdd a, Multiplicative.ofAdd c) := by
        ext <;> simp [a, c]
      rw [he1, ha, hc0]
      rfl
    · have he2 : β order36_E9_e2 = (Multiplicative.ofAdd b, Multiplicative.ofAdd d) := by
        ext <;> simp [b, d]
      rw [he2, hb0, hd]
      rfl
  · right
    left
    rcases h with ⟨ha, hb0, hc0, hd⟩
    apply order36_E9_mulAut_ext
    · have he1 : β order36_E9_e1 = (Multiplicative.ofAdd a, Multiplicative.ofAdd c) := by
        ext <;> simp [a, c]
      rw [he1, ha, hc0]
      simp
    · have he2 : β order36_E9_e2 = (Multiplicative.ofAdd b, Multiplicative.ofAdd d) := by
        ext <;> simp [b, d]
      rw [he2, hb0, hd]
      simp
  · right
    right
    left
    rcases h with ⟨ha, hb0, hc0, hd⟩
    apply order36_E9_mulAut_ext
    · have he1 : β order36_E9_e1 = (Multiplicative.ofAdd a, Multiplicative.ofAdd c) := by
        ext <;> simp [a, c]
      rw [he1, ha, hc0]
      simp
    · have he2 : β order36_E9_e2 = (Multiplicative.ofAdd b, Multiplicative.ofAdd d) := by
        ext <;> simp [b, d]
      rw [he2, hb0, hd]
      simp
  · right
    right
    right
    rcases h with ⟨ha, hb0, hc0, hd⟩
    apply order36_E9_mulAut_ext
    · have he1 : β order36_E9_e1 = (Multiplicative.ofAdd a, Multiplicative.ofAdd c) := by
        ext <;> simp [a, c]
      rw [he1, ha, hc0]
      simp
    · have he2 : β order36_E9_e2 = (Multiplicative.ofAdd b, Multiplicative.ofAdd d) := by
        ext <;> simp [b, d]
