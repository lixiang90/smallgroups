  · change θ.symm (α (θ order36_E9_e1)) = τ order36_E9_e1
    rw [h1]
    exact θ.left_inv _
  · change θ.symm (α (θ order36_E9_e2)) = τ order36_E9_e2
    rw [h2]
    exact θ.left_inv _

