    (θ α τ : MulAut order36_E9) (h : (MulAut.conj θ.symm) α = τ) (x : order36_E9) :
    α (θ x) = θ (τ x) := by
  have hx := congrArg (fun f : MulAut order36_E9 => f x) h
  change θ.symm (α (θ x)) = τ x at hx
  calc
    α (θ x) = θ (θ.symm (α (θ x))) := (θ.right_inv _).symm
    _ = θ (τ x) := by rw [hx]

