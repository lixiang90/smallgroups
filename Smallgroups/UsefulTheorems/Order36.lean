  have hright : orderOf x.2 ∣ 4 := by
    have hcard : Nat.card (alternatingGroup.kleinFour (Fin 4)) = 4 := by
      simpa using alternatingGroup.kleinFour_card_of_card_eq_four (α := Fin 4) (by simp)
