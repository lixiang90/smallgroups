/-- The shear semidirect product is non-abelian. -/
theorem order81_c9c3_shear_rep_nonabelian :
    ¬ ∀ x y : order81_c9c3_shear_rep, x * y = y * x := by
  intro hcomm
  let g : CyclicRep 3 := Multiplicative.ofAdd (1 : ZMod 3)
  let n : order81_C9C3 :=
