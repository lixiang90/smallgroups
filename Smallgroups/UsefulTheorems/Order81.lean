/-- The additive homomorphism `ZMod 3 → ZMod 9`, `b ↦ 3 * b`. -/
noncomputable def order81_c9c3_liftAddHom : ZMod 3 →+ ZMod 9 where
  toFun b := (3 : ZMod 9) * b.val
  map_zero' := by decide +kernel
  map_add' := by
    intro b d
    fin_cases b <;> fin_cases d <;> decide +kernel

/-- The additive shear `(a, b) ↦ (a + 3b, b)` on `ZMod 9 × ZMod 3`. -/
noncomputable def order81_c9c3_liftAddEquiv : (ZMod 9 × ZMod 3) ≃+ (ZMod 9 × ZMod 3) where
  toFun x := (x.1 + order81_c9c3_liftAddHom x.2, x.2)
  invFun x := (x.1 - order81_c9c3_liftAddHom x.2, x.2)
  left_inv := by
    intro x
    ext
    · simp
    · rfl
  right_inv := by
    intro x
    ext
    · simp
    · rfl
  map_add' := by
    intro x y
    ext
    · simp [map_add, add_assoc, add_left_comm, add_comm]
    · rfl

