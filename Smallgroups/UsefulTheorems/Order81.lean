    (x * y).n =
      x.n + order81_c9c3_nonSplitAct x.t y.n + order81_c9c3_nonSplitCarry x.t y.t :=
  rfl

@[simp] theorem mul_t (x y : Order81C9C3NonSplit) :
    (x * y).t = x.t + y.t :=
  rfl

@[simp] theorem one_n : (1 : Order81C9C3NonSplit).n = 0 :=
