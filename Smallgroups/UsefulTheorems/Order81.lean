theorem order81_e27_jordan_rep_not_equiv_c9_semidirect_c9_rep :
    ¬ Nonempty (order81_e27_jordan_rep ≃* order81_c9_semidirect_c9_rep) :=
  order81_not_nonempty_mulEquiv_of_pow_eq_one_card_ne
    (H := order81_e27_jordan_rep) (K := order81_c9_semidirect_c9_rep) (n := 3) (by
