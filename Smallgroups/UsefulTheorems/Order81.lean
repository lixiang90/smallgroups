/-! ## A split elementary-abelian extension by `C_3` -/

/-- `C_3 × C_3 × C_3`, written multiplicatively. -/
abbrev order81_E27 : Type :=
  Multiplicative ((ZMod 3 × ZMod 3) × ZMod 3)

/-- The additive Jordan shear `(a, b, c) ↦ (a, b + a, c + b)` on `(ZMod 3)^3`. -/
noncomputable def order81_e27_jordanAddEquiv :
    ((ZMod 3 × ZMod 3) × ZMod 3) ≃+ ((ZMod 3 × ZMod 3) × ZMod 3) where
  toFun x := ((x.1.1, x.1.2 + x.1.1), x.2 + x.1.2)
  invFun x := ((x.1.1, x.1.2 - x.1.1), x.2 - x.1.2 + x.1.1)
  left_inv := by
    intro x
    ext <;> simp [add_comm]
  right_inv := by
    intro x
    ext <;> simp [add_assoc, add_comm]
  map_add' := by
    intro x y
    ext <;> simp [add_left_comm, add_comm]

/-- The corresponding automorphism of `C_3 × C_3 × C_3`. -/
noncomputable def order81_e27_jordanAut : MulAut order81_E27 :=
  AddEquiv.toMultiplicative order81_e27_jordanAddEquiv

@[simp] theorem order81_e27_jordanAut_apply (a b c : ZMod 3) :
    order81_e27_jordanAut
      (Multiplicative.ofAdd (((a, b), c) : (ZMod 3 × ZMod 3) × ZMod 3)) =
      Multiplicative.ofAdd (((a, b + a), c + b) : (ZMod 3 × ZMod 3) × ZMod 3) := by
  rfl

/-- The Jordan automorphism has order dividing `3`. -/
theorem order81_e27_jordanAut_pow_three : order81_e27_jordanAut ^ 3 = 1 := by
  ext x <;> fin_cases x <;> rfl

/-- The `C_3` action on `C_3 × C_3 × C_3` generated by the Jordan automorphism. -/
noncomputable abbrev order81_e27_jordanAction : CyclicRep 3 →* MulAut order81_E27 :=
  order81_actionOfOrderThree order81_e27_jordanAut order81_e27_jordanAut_pow_three

/-- The split semidirect product `(C_3 × C_3 × C_3) ⋊ C_3` with Jordan action. -/
abbrev order81_e27_jordan_rep : Type :=
  SemidirectProduct order81_E27 (CyclicRep 3) order81_e27_jordanAction

theorem card_order81_E27 : Nat.card order81_E27 = 27 := by
  simp [order81_E27, Nat.card_eq_fintype_card, Fintype.card_multiplicative,
    Fintype.card_prod]

/-- The Jordan representative has order `81`. -/
theorem card_order81_e27_jordan_rep : Nat.card order81_e27_jordan_rep = 81 := by
  rw [order81_e27_jordan_rep, SemidirectProduct.card, card_order81_E27,
    card_cyclicRep (by norm_num : (3 : ℕ) ≠ 0)]

theorem order81_e27_jordanAction_gen :
    order81_e27_jordanAction (Multiplicative.ofAdd (1 : ZMod 3)) =
      order81_e27_jordanAut :=
  order81_actionOfOrderThree_ofAdd_one _ _

/-- The Jordan representative is non-abelian. -/
theorem order81_e27_jordan_rep_nonabelian :
    ¬ ∀ x y : order81_e27_jordan_rep, x * y = y * x := by
  intro hcomm
  let g : CyclicRep 3 := Multiplicative.ofAdd (1 : ZMod 3)
  let n : order81_E27 :=
    Multiplicative.ofAdd ((((1 : ZMod 3), 0), 0) : (ZMod 3 × ZMod 3) × ZMod 3)
  have hfix : order81_e27_jordanAut n = n := by
    have heq : (SemidirectProduct.inl (order81_e27_jordanAction g n) :
        order81_e27_jordan_rep) = SemidirectProduct.inl n := by
      have h := hcomm (SemidirectProduct.inr g : order81_e27_jordan_rep)
        (SemidirectProduct.inl n : order81_e27_jordan_rep)
      rw [SemidirectProduct.inl_aut (φ := order81_e27_jordanAction) g n]
      rw [h, mul_assoc, ← map_mul, mul_inv_cancel, map_one]
      simp
    have hinj := SemidirectProduct.inl_injective heq
    simpa [g, order81_e27_jordanAction_gen] using hinj
  have hnot : order81_e27_jordanAut n ≠ n := by
    intro h
    have hadd := congrArg Multiplicative.toAdd h
    norm_num [n] at hadd
  exact hnot hfix

theorem card_pow_three_eq_one_order81_e27_jordan_rep :
    order81_pow_eq_one_card order81_e27_jordan_rep 3 = 45 :=
  order81_nat_card_eq_of_fintype_card_eq (by decide +kernel)

theorem order81_e27_jordan_rep_not_equiv_heisenberg_prod_cyclic :
    ¬ Nonempty (order81_e27_jordan_rep ≃* order81_heisenberg_prod_cyclic) :=
  order81_not_nonempty_mulEquiv_of_pow_eq_one_card_ne
    (H := order81_e27_jordan_rep) (K := order81_heisenberg_prod_cyclic) (n := 3) (by
      rw [card_pow_three_eq_one_order81_e27_jordan_rep,
        card_pow_three_eq_one_order81_heisenberg_prod_cyclic]
      norm_num)

theorem order81_e27_jordan_rep_not_equiv_semidirectP2P_prod_cyclic :
    ¬ Nonempty (order81_e27_jordan_rep ≃* order81_semidirectP2P_prod_cyclic) :=
  order81_not_nonempty_mulEquiv_of_pow_eq_one_card_ne
    (H := order81_e27_jordan_rep) (K := order81_semidirectP2P_prod_cyclic) (n := 3) (by
      rw [card_pow_three_eq_one_order81_e27_jordan_rep,
        card_pow_three_eq_one_order81_semidirectP2P_prod_cyclic]
      norm_num)

theorem order81_e27_jordan_rep_not_equiv_c9c3_shear_rep :
    ¬ Nonempty (order81_e27_jordan_rep ≃* order81_c9c3_shear_rep) :=
  order81_not_nonempty_mulEquiv_of_pow_eq_one_card_ne
    (H := order81_e27_jordan_rep) (K := order81_c9c3_shear_rep) (n := 3) (by
      rw [card_pow_three_eq_one_order81_e27_jordan_rep,
        card_pow_three_eq_one_order81_c9c3_shear_rep]
      norm_num)

theorem order81_e27_jordan_rep_not_equiv_c27_semidirect_rep :
    ¬ Nonempty (order81_e27_jordan_rep ≃* order81_c27_semidirect_rep) :=
  order81_not_nonempty_mulEquiv_of_pow_eq_one_card_ne
    (H := order81_e27_jordan_rep) (K := order81_c27_semidirect_rep) (n := 3) (by
      rw [card_pow_three_eq_one_order81_e27_jordan_rep,
