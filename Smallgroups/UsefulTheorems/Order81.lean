    orderOf (order81_c9c3_shear_orderNineElem ^ 3) = 3 := by
  have hpow : (order81_c9c3_shear_orderNineElem ^ 3) ^ 3 = 1 := by decide +kernel
  have hne : order81_c9c3_shear_orderNineElem ^ 3 ≠ 1 := by decide +kernel
  exact orderOf_eq_prime hpow hne

theorem order81_c9c3_shear_commutator_witness_eq :
    order81_c9c3_shear_actionGen * order81_c9c3_shear_orderNineElem *
