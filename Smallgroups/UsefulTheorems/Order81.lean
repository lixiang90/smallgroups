/-! ## The currently formalized representatives -/

/-- The six currently certified non-abelian representatives of order `81`. -/
abbrev order81_nonabelian_reps : Fin 6 → Type :=
  rep6 order81_heisenberg_prod_cyclic order81_semidirectP2P_prod_cyclic
    order81_c9c3_shear_rep order81_c27_semidirect_rep order81_c9_semidirect_c9_rep
    order81_e27_jordan_rep

/-- Each currently certified non-abelian representative has order `81`. -/
theorem card_order81_nonabelian_reps (i : Fin 6) :
    Nat.card (order81_nonabelian_reps i) = 81 := by
  fin_cases i
  · exact card_order81_heisenberg_prod_cyclic
  · exact card_order81_semidirectP2P_prod_cyclic
  · exact card_order81_c9c3_shear_rep
  · exact card_order81_c27_semidirect_rep
  · exact card_order81_c9_semidirect_c9_rep
  · exact card_order81_e27_jordan_rep

/-- Each currently certified non-abelian representative is non-abelian. -/
theorem order81_nonabelian_reps_nonabelian (i : Fin 6) :
    ¬ ∀ x y : order81_nonabelian_reps i, x * y = y * x := by
  fin_cases i
  · exact order81_heisenberg_prod_cyclic_nonabelian
  · exact order81_semidirectP2P_prod_cyclic_nonabelian
  · exact order81_c9c3_shear_rep_nonabelian
  · exact order81_c27_semidirect_rep_nonabelian
  · exact order81_c9_semidirect_c9_rep_nonabelian
  · exact order81_e27_jordan_rep_nonabelian

/-- The six currently certified non-abelian representatives are pairwise non-isomorphic. -/
theorem order81_nonabelian_reps_pairwise :
    PairwiseNonMulEquiv order81_nonabelian_reps := by
  intro i j h
  fin_cases i
  · fin_cases j
    · rfl
    · exact absurd h order81_heisenberg_prod_cyclic_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd ⟨h.some.symm⟩ order81_c9c3_shear_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd ⟨h.some.symm⟩ order81_c27_semidirect_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd ⟨h.some.symm⟩ order81_c9_semidirect_c9_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd ⟨h.some.symm⟩ order81_e27_jordan_rep_not_equiv_heisenberg_prod_cyclic
  · fin_cases j
    · exact absurd ⟨h.some.symm⟩
        order81_heisenberg_prod_cyclic_not_equiv_semidirectP2P_prod_cyclic
    · rfl
    · exact absurd ⟨h.some.symm⟩
        order81_c9c3_shear_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd ⟨h.some.symm⟩
        order81_c27_semidirect_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd ⟨h.some.symm⟩
        order81_c9_semidirect_c9_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd ⟨h.some.symm⟩
        order81_e27_jordan_rep_not_equiv_semidirectP2P_prod_cyclic
  · fin_cases j
    · exact absurd h order81_c9c3_shear_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd h order81_c9c3_shear_rep_not_equiv_semidirectP2P_prod_cyclic
    · rfl
    · exact absurd ⟨h.some.symm⟩ order81_c27_semidirect_rep_not_equiv_c9c3_shear_rep
    · exact absurd ⟨h.some.symm⟩ order81_c9_semidirect_c9_rep_not_equiv_c9c3_shear_rep
    · exact absurd ⟨h.some.symm⟩ order81_e27_jordan_rep_not_equiv_c9c3_shear_rep
  · fin_cases j
    · exact absurd h order81_c27_semidirect_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd h order81_c27_semidirect_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd h order81_c27_semidirect_rep_not_equiv_c9c3_shear_rep
    · rfl
    · exact absurd h order81_c27_semidirect_rep_not_equiv_c9_semidirect_c9_rep
    · exact absurd ⟨h.some.symm⟩ order81_e27_jordan_rep_not_equiv_c27_semidirect_rep
  · fin_cases j
    · exact absurd h order81_c9_semidirect_c9_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd h order81_c9_semidirect_c9_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd h order81_c9_semidirect_c9_rep_not_equiv_c9c3_shear_rep
    · exact absurd ⟨h.some.symm⟩ order81_c27_semidirect_rep_not_equiv_c9_semidirect_c9_rep
    · rfl
    · exact absurd ⟨h.some.symm⟩ order81_e27_jordan_rep_not_equiv_c9_semidirect_c9_rep
  · fin_cases j
    · exact absurd h order81_e27_jordan_rep_not_equiv_heisenberg_prod_cyclic
    · exact absurd h order81_e27_jordan_rep_not_equiv_semidirectP2P_prod_cyclic
    · exact absurd h order81_e27_jordan_rep_not_equiv_c9c3_shear_rep
    · exact absurd h order81_e27_jordan_rep_not_equiv_c27_semidirect_rep
    · exact absurd h order81_e27_jordan_rep_not_equiv_c9_semidirect_c9_rep
    · rfl

/-- The five abelian representatives together with the currently certified non-abelian
representatives formalized above. -/
abbrev order81_known_reps : Fin 5 ⊕ Fin 6 → Type :=
  Sum.elim order81_abelian_reps order81_nonabelian_reps

/-- Every currently formalized representative has order `81`. -/
theorem card_order81_known_reps (i : Fin 5 ⊕ Fin 6) :
    Nat.card (order81_known_reps i) = 81 := by
  rcases i with i | i
  · exact card_order81_abelian_reps i
  · exact card_order81_nonabelian_reps i

/-- No abelian representative is isomorphic to one of the currently certified non-abelian
representatives. -/
theorem order81_abelian_nonabelian_disjoint :
    ∀ i j, ¬ Nonempty (order81_abelian_reps i ≃* order81_nonabelian_reps j) :=
  pairwise_disjoint_of_comm_noncomm
    (fun _ a b => mul_comm a b)
    order81_nonabelian_reps_nonabelian

/-- The currently formalized eleven representatives are pairwise non-isomorphic. -/
theorem order81_known_reps_pairwise : PairwiseNonMulEquiv order81_known_reps := by
  simpa [order81_known_reps] using
    PairwiseNonMulEquiv.sum order81_abelian_distinct order81_nonabelian_reps_pairwise
      order81_abelian_nonabelian_disjoint

end Smallgroups.UsefulTheorems
