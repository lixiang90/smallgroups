/-! ## A split `C_9` extension by `C_9` -/

/-- `C_9`, written multiplicatively. -/
abbrev order81_C9 : Type :=
  CyclicRep 9

/-- The unit `4` of `ZMod 9`, whose order divides `9`. -/
noncomputable abbrev order81_u4 : (ZMod 9)ˣ :=
  ZMod.unitOfCoprime 4 (by norm_num : Nat.Coprime 4 9)

theorem order81_u4_pow_nine : order81_u4 ^ 9 = 1 := by
  decide

/-- The `C_9` action on `C_9` generated by multiplication by `4`. -/
noncomputable abbrev order81_c9Action : order81_C9 →* MulAut order81_C9 :=
  unitAutHom.comp (powHom (p := 9) (q := 9) order81_u4 order81_u4_pow_nine)

/-- The split semidirect product `C_9 ⋊ C_9` with action generated by multiplication by `4`. -/
abbrev order81_c9_semidirect_c9_rep : Type :=
  SemidirectProduct order81_C9 order81_C9 order81_c9Action

theorem card_order81_C9 : Nat.card order81_C9 = 9 := by
  rw [card_cyclicRep (by norm_num : (9 : ℕ) ≠ 0)]

/-- The `C_9 ⋊ C_9` representative has order `81`. -/
