    cubeSubgroup order81_c9c3_shear_rep ≤
      Subgroup.zpowers (order81_c9c3_shear_orderNineElem ^ 3) := by
  rw [cubeSubgroup, Subgroup.closure_le]
  intro z hz
  rcases hz with ⟨x, rfl⟩
  exact order81_c9c3_shear_cube_mem_zpowers x

theorem orderOf_order81_c9c3_shear_orderNineElem_cube :
    orderOf (order81_c9c3_shear_orderNineElem ^ 3) = 3 := by
  have hpow : (order81_c9c3_shear_orderNineElem ^ 3) ^ 3 = 1 := by decide +kernel
  have hne : order81_c9c3_shear_orderNineElem ^ 3 ≠ 1 := by decide +kernel
  exact orderOf_eq_prime hpow hne

theorem order81_c9c3_shear_commutator_witness_eq :
    order81_c9c3_shear_actionGen * order81_c9c3_shear_orderNineElem *
        order81_c9c3_shear_actionGen⁻¹ * order81_c9c3_shear_orderNineElem⁻¹ =
      order81_c9c3_shear_bElem := by
  decide +kernel

theorem order81_c9c3_shear_bElem_not_mem_zpowers :
    order81_c9c3_shear_bElem ∉
      Subgroup.zpowers (order81_c9c3_shear_orderNineElem ^ 3) := by
  intro h
  rw [Subgroup.mem_zpowers_iff] at h
  rcases h with ⟨k, hk⟩
  have hmod : k ≡ k % 3 [ZMOD (3 : ℤ)] := by
    rw [Int.modEq_iff_dvd]
    refine ⟨-(k / 3), ?_⟩
    have h := Int.emod_add_mul_ediv k 3
    omega
  have hpow : (order81_c9c3_shear_orderNineElem ^ 3) ^ k =
      (order81_c9c3_shear_orderNineElem ^ 3) ^ (k % 3) := by
    apply zpow_eq_zpow_iff_modEq.mpr
    rw [orderOf_order81_c9c3_shear_orderNineElem_cube]
    exact hmod
  have hcases : k % 3 = 0 ∨ k % 3 = 1 ∨ k % 3 = 2 := by
    have hnonneg : 0 ≤ k % 3 := Int.emod_nonneg k (by norm_num)
    have hlt : k % 3 < 3 := Int.emod_lt_of_pos k (by norm_num)
    omega
  rcases hcases with h0 | h1 | h2
  · have hb : order81_c9c3_shear_bElem = 1 := by rw [← hk, hpow, h0]; simp
    have : order81_c9c3_shear_bElem ≠ 1 := by decide +kernel
    exact this hb
  · have hb : order81_c9c3_shear_bElem = order81_c9c3_shear_orderNineElem ^ 3 := by
      rw [← hk, hpow, h1]
      simp
    have : order81_c9c3_shear_bElem ≠ order81_c9c3_shear_orderNineElem ^ 3 := by
      decide +kernel
    exact this hb
  · have hb : order81_c9c3_shear_bElem = order81_c9c3_shear_orderNineElem ^ 6 := by
      rw [← hk, hpow, h2]
      change (order81_c9c3_shear_orderNineElem ^ 3) ^ (2 : ℕ) =
        order81_c9c3_shear_orderNineElem ^ 6
      rw [← pow_mul]
    have : order81_c9c3_shear_bElem ≠ order81_c9c3_shear_orderNineElem ^ 6 := by
      decide +kernel
    exact this hb

