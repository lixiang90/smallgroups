  rw [order81_c9_semidirect_c9_rep, SemidirectProduct.card, card_order81_C9]

theorem order81_c9Action_gen :
    order81_c9Action (Multiplicative.ofAdd (1 : ZMod 9)) = unitAutHom order81_u4 := by
  change unitAutHom (powHom (p := 9) (q := 9) order81_u4 order81_u4_pow_nine
    (Multiplicative.ofAdd (1 : ZMod 9))) = unitAutHom order81_u4
  change unitAutHom (order81_u4 ^ (1 : ZMod 9).val) = unitAutHom order81_u4
  rw [show (1 : ZMod 9).val = 1 by decide, pow_one]

