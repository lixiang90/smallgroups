    x ^ 3 ∈ Subgroup.zpowers (order81_c9c3_shear_orderNineElem ^ 3) := by
  cases x with
  | mk n g =>
      cases n with
      | mk a b =>
          fin_cases a <;> fin_cases b <;> fin_cases g <;>
            rw [Subgroup.mem_zpowers_iff] <;>
            first
            | exact ⟨0, by decide +kernel⟩
            | exact ⟨1, by decide +kernel⟩
            | exact ⟨2, by decide +kernel⟩

